<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="60dp" android:background="#2ECC71" android:gravity="center_vertical" android:padding="10dp"><Button android:id="@+id/btnBack" android:text="BACK" android:layout_width="70dp" android:layout_height="44dp"/><TextView android:text="SUPER UNPACK - FULL TOOLS" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center"/></LinearLayout>
<TextView android:text="super.img" android:textSize="11sp" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textStyle="bold"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="48dp" android:background="#EEEEEE" android:gravity="center_vertical" android:padding="8dp"><TextView android:id="@+id/txt_super.img" android:text="/sdcard/Download/" android:textSize="11sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btn_super.img" android:text="BROWSE" android:layout_width="80dp" android:layout_height="38dp" android:textSize="10sp"/></LinearLayout>
<TextView android:text="Output folder /sdcard/Download/out/" android:textSize="11sp" android:textColor="#000000" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textStyle="bold"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="48dp" android:background="#EEEEEE" android:gravity="center_vertical" android:padding="8dp"><TextView android:id="@+id/txt_Output_folder_/sdcard/Download/out/" android:text="/sdcard/Download/" android:textSize="11sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btn_Output_folder_/sdcard/Download/out/" android:text="BROWSE" android:layout_width="80dp" android:layout_height="38dp" android:textSize="10sp"/></LinearLayout>

<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
<Button android:id="@+id/btn_LIST_inside_super_lpdump" android:text="LIST inside super lpdump" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_UNPACK_ALL_lpunpack" android:text="UNPACK ALL lpunpack" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_EXTRACT_system.img" android:text="EXTRACT system.img" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_EXTRACT_vendor.img" android:text="EXTRACT vendor.img" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_EXTRACT_product.img" android:text="EXTRACT product.img" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_MOUNT_system" android:text="MOUNT system" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_RESIZE_super" android:text="RESIZE super" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_FLASH_super" android:text="FLASH super" android:layout_width="match_parent" android:layout_height="60dp" android:textSize="11sp" android:layout_marginTop="6dp" android:backgroundTint="#2ECC71"/>

</LinearLayout>
<ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="18dp" android:max="100" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/txtDetail" android:text="Ready - Full Tools" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
<TextView android:id="@+id/logView" android:text="LOG SUPER UNPACK - FULL" android:textSize="10sp" android:background="#111111" android:textColor="#00FF00" android:padding="8dp" android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="8dp"/>
</LinearLayout></ScrollView>