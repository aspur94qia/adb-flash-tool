<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="60dp" android:background="#2ECC71" android:gravity="center_vertical" android:padding="10dp"><Button android:id="@+id/btnBack" android:text="BACK" android:layout_width="70dp" android:layout_height="44dp"/><TextView android:text="QCN EFS PC FULL - PC PARITY" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center"/></LinearLayout>
<TextView android:text="QPST QFIL QCN Backup Restore PC" android:textSize="11sp" android:background="#F5F5F5" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
<TextView android:text="QCN backup.qcn" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:background="#EEEEEE" android:gravity="center_vertical" android:padding="8dp"><TextView android:id="@+id/txt_QCN_backup.qcn" android:text="/sdcard/Download/" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btn_QCN_backup.qcn" android:text="BROWSE" android:layout_width="80dp" android:layout_height="38dp" android:textSize="10sp"/></LinearLayout>
<TextView android:text="EFS folder" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:background="#EEEEEE" android:gravity="center_vertical" android:padding="8dp"><TextView android:id="@+id/txt_EFS_folder" android:text="/sdcard/Download/" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btn_EFS_folder" android:text="BROWSE" android:layout_width="80dp" android:layout_height="38dp" android:textSize="10sp"/></LinearLayout>

<TextView android:text="OPTIONS (samain kaya PC):" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
<CheckBox android:id="@+id/cb_Backup_All" android:text="Backup All" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>
<CheckBox android:id="@+id/cb_Restore_All" android:text="Restore All" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>
<CheckBox android:id="@+id/cb_UFS" android:text="UFS" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>
<CheckBox android:id="@+id/cb_EMMC" android:text="EMMC" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>

<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<Button android:id="@+id/btn_BACKUP_modemst1_dd" android:text="BACKUP modemst1 dd" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_modemst2_dd" android:text="BACKUP modemst2 dd" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_fsg_dd" android:text="BACKUP fsg dd" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_fsc_dd" android:text="BACKUP fsc dd" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_efs1_efs2_dd" android:text="BACKUP efs1+efs2 dd" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_FULL_4_files" android:text="BACKUP FULL 4 files" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_RESTORE_modemst1" android:text="RESTORE modemst1" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_RESTORE_modemst2" android:text="RESTORE modemst2" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_RESTORE_fsg" android:text="RESTORE fsg" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_RESTORE_efs1_efs2" android:text="RESTORE efs1+efs2" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_DIAG_enable_diag,adb" android:text="DIAG enable diag,adb" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_QCN_Rebuild" android:text="QCN Rebuild" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>

</LinearLayout>
<ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="16dp" android:max="100" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/txtDetail" android:text="Ready PC Parity" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
<TextView android:id="@+id/logView" android:text="LOG QCN EFS PC FULL PC PARITY - semua fungsi jalan" android:textSize="10sp" android:background="#111111" android:textColor="#00FF00" android:padding="8dp" android:layout_width="match_parent" android:layout_height="400dp" android:layout_marginTop="8dp"/>
</LinearLayout></ScrollView>