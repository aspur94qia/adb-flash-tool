<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<Button android:id="@+id/btn_DEVICES_adb_devices" android:text="DEVICES adb devices" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
