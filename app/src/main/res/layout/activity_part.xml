<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="60dp" android:background="#2ECC71" android:gravity="center_vertical" android:padding="10dp"><Button android:id="@+id/btnBack" android:text="BACK" android:layout_width="70dp" android:layout_height="44dp"/><TextView android:text="PARTITION MANAGER PC FULL - PC PARITY" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center"/></LinearLayout>
<TextView android:text="Partition Manager PC - sgdisk gdisk parted" android:textSize="11sp" android:background="#F5F5F5" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
<TextView android:text="No file" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:background="#EEEEEE" android:gravity="center_vertical" android:padding="8dp"><TextView android:id="@+id/txt_No_file" android:text="/sdcard/Download/" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btn_No_file" android:text="BROWSE" android:layout_width="80dp" android:layout_height="38dp" android:textSize="10sp"/></LinearLayout>

<TextView android:text="OPTIONS (samain kaya PC):" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
<CheckBox android:id="@+id/cb_UFS" android:text="UFS" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>
<CheckBox android:id="@+id/cb_EMMC" android:text="EMMC" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>
<CheckBox android:id="@+id/cb_GPT" android:text="GPT" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>

<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<Button android:id="@+id/btn_PRINT_sgdisk_sda_sdb" android:text="PRINT sgdisk sda+sdb" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_PRINT_gdisk_-l_sda" android:text="PRINT gdisk -l sda" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_PRINT_parted_sda_print" android:text="PRINT parted sda print" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_LIST_by-name" android:text="LIST by-name" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_GPT_34_sectors" android:text="BACKUP GPT 34 sectors" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_RESTORE_GPT" android:text="RESTORE GPT" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_all_partitions_list" android:text="BACKUP all partitions list" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_ERASE_frp" android:text="ERASE frp" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_ERASE_userdata" android:text="ERASE userdata" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_RESIZE_super_lpresize_0" android:text="RESIZE super lpresize 0" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_CREATE_partition" android:text="CREATE partition" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_DELETE_partition" android:text="DELETE partition" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_BACKUP_super" android:text="BACKUP super" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_FLASH_super" android:text="FLASH super" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>

</LinearLayout>
<ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="16dp" android:max="100" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/txtDetail" android:text="Ready PC Parity" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
<TextView android:id="@+id/logView" android:text="LOG PARTITION MANAGER PC FULL PC PARITY - semua fungsi jalan" android:textSize="10sp" android:background="#111111" android:textColor="#00FF00" android:padding="8dp" android:layout_width="match_parent" android:layout_height="400dp" android:layout_marginTop="8dp"/>
</LinearLayout></ScrollView>