<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="10dp">
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="60dp" android:background="#2ECC71" android:gravity="center_vertical" android:padding="10dp"><Button android:id="@+id/btnBack" android:text="BACK" android:layout_width="70dp" android:layout_height="44dp"/><TextView android:text="OFP EXTRACT PC FULL - PC PARITY" android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center"/></LinearLayout>
<TextView android:text="OPPO Realme OFP Decrypt PC" android:textSize="11sp" android:background="#F5F5F5" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
<TextView android:text="firmware.ofp" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:background="#EEEEEE" android:gravity="center_vertical" android:padding="8dp"><TextView android:id="@+id/txt_firmware.ofp" android:text="/sdcard/Download/" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btn_firmware.ofp" android:text="BROWSE" android:layout_width="80dp" android:layout_height="38dp" android:textSize="10sp"/></LinearLayout>
<TextView android:text="Output out/" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/><LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="50dp" android:background="#EEEEEE" android:gravity="center_vertical" android:padding="8dp"><TextView android:id="@+id/txt_Output_out_" android:text="/sdcard/Download/" android:textSize="10sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/btn_Output_out_" android:text="BROWSE" android:layout_width="80dp" android:layout_height="38dp" android:textSize="10sp"/></LinearLayout>

<TextView android:text="OPTIONS (samain kaya PC):" android:textSize="11sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
<CheckBox android:id="@+id/cb_Decrypt_Only" android:text="Decrypt Only" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>
<CheckBox android:id="@+id/cb_Extract_super_only" android:text="Extract super only" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"/>

<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<Button android:id="@+id/btn_EXTRACT_OFP_all" android:text="EXTRACT OFP all" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_EXTRACT_super_only" android:text="EXTRACT super only" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_DECRYPT_OFP" android:text="DECRYPT OFP" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_LIST_OFP_files" android:text="LIST OFP files" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_FLASH_OFP_extracted" android:text="FLASH OFP extracted" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>
<Button android:id="@+id/btn_CONVERT_OFP_to_scatter" android:text="CONVERT OFP to scatter" android:layout_width="match_parent" android:layout_height="58dp" android:textSize="11sp" android:layout_marginTop="5dp" android:backgroundTint="#2ECC71"/>

</LinearLayout>
<ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="16dp" android:max="100" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/txtDetail" android:text="Ready PC Parity" android:textSize="11sp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"/>
<TextView android:id="@+id/logView" android:text="LOG OFP EXTRACT PC FULL PC PARITY - semua fungsi jalan" android:textSize="10sp" android:background="#111111" android:textColor="#00FF00" android:padding="8dp" android:layout_width="match_parent" android:layout_height="400dp" android:layout_marginTop="8dp"/>
</LinearLayout></ScrollView>